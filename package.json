{
  "name": "ai-code-mentor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n frontend,backend -c cyan,green \"npm run client\" \"set FLASK_ENV=development&& set HOST_EXECUTION_ENABLED=1&& .venv\\Scripts\\python.exe app.py\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "set FLASK_ENV=development&& set HOST_EXECUTION_ENABLED=1&& .venv\\Scripts\\python.exe app.py",
    "server": "set FLASK_ENV=development&& set HOST_EXECUTION_ENABLED=1&& .venv\\Scripts\\python.exe app.py",
    "client": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:py": "ruff check .",
    "lint:py:fix": "ruff check . --fix",
    "test:e2e": "playwright test",
    "test:testsprite:backend": "powershell -ExecutionPolicy Bypass -File scripts/verify-backend-api.ps1",
    "test:testsprite:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-testsprite-env.ps1",
    "prepare": "husky"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "remark-gfm": "^4.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{py}": "ruff check --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.54.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.2.0"
  }
}
