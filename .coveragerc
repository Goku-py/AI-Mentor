[run]
# pytest.ini used to pass `--cov=.`, which measured the whole repo (venv/,
# node_modules/, dist/). It now names the three source packages explicitly;
# this list keeps the same scoping for any ad-hoc `coverage run` invocation.
source =
    app_pkg
    analyzer
    models_pkg
omit =
    venv/*
    tests/*
    migrations/*
    setup.ps1
    setup.sh

[report]
# Measured total is 68% (rising as the suite grows). Floor sits well below it
# so the gate catches regressions without failing CI on day one.
fail_under = 58
show_missing = True
skip_covered = False

[html]
directory = htmlcov