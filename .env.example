# ============================================================
# AI Code Mentor — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.
# ============================================================

# --- AI / External APIs ---
# Get your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here
# Stable default model; override only when intentionally testing another Gemini model.
GEMINI_MODEL=gemini-2.5-flash

# --- TestSprite MCP (Cursor only — do not commit real keys) ---
# Create at https://www.testsprite.com/dashboard/settings/apikey
# Set the same value in Cursor MCP env as API_KEY, or export before running scripts.
TESTSPRITE_API_KEY=

# --- Flask Core ---
FLASK_ENV=development
PORT=5000

# --- Security: Session Cookie ---
# Must be a long (>=32 char) random string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In development this is auto-generated per process if left empty.
# In production this MUST be set or the server will refuse to start.
SECRET_KEY=

# --- Security: CSRF Protection ---
# Another independent random string for CSRF tokens.
# Generate the same way as SECRET_KEY above.
WTF_CSRF_SECRET_KEY=

# --- Auth: JWT Secret ---
# Independent key used to sign JSON Web Tokens.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# --- Auth: GitHub OAuth ---
# Register your app at https://github.com/settings/developers
# Callback URL: http://localhost:5000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Auth: Database ---
# Default: SQLite file in the instance/ folder (zero config, dev-only).
# Production: set to a PostgreSQL URL for persistence across restarts.
#   Example: DATABASE_URL=postgresql://user:pass@host:5432/ai_mentor
DATABASE_URL=sqlite:///app.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Security: CORS ---
# Comma-separated list of allowed frontend origins.
# NEVER use * in production — set your exact frontend URL.
# Examples:
#   Development:  ALLOWED_ORIGINS=http://localhost:5173
#   Production:   ALLOWED_ORIGINS=https://your-app.railway.app
ALLOWED_ORIGINS=http://localhost:5173

# --- Security: API Key Gating ---
# Optional API key required to call /api/v1/analyze.
# Leave empty to allow unauthenticated access in dev.
ANALYZE_API_KEY=

# --- Rate Limiting ---
# Use memory:// in development.
# Use redis://host:port in production for multi-worker support.
RATE_LIMIT_STORAGE_URI=memory://

# --- Metrics ---
# Optional API key to access /api/v1/metrics in production.
METRICS_API_KEY=

# --- Concurrency ---
# Max concurrent code analysis requests (per-process).
MAX_ANALYZE_CONCURRENCY=4

# --- AI / Gemini ---
# Daily global cap on AI mentor calls across all users.
MAX_GLOBAL_AI_CALLS_PER_DAY=5000

# --- Frontend ---
# Set this if your React frontend talks to a different backend host.
# Leave empty when Flask serves the built frontend from /dist.
VITE_API_URL=

# --- Dev Proxy ---
# Used by Vite dev server to proxy API calls.
VITE_PROXY_TARGET=http://localhost:5000

# --- App Version ---
# Published release tag; used in health checks and logs.
APP_VERSION=1.0.0

# --- Proxy (Cloud deployments) ---
# Set to 1 on Railway / Render / Heroku for correct IP-based rate limiting.
TRUSTED_PROXY_COUNT=0
